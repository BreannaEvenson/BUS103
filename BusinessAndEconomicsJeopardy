<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Business Review Jeopardy</title>

<style>
:root {
    --sauk-light: #f4f4f4;
    --sauk-red: #c8102e;
    --sauk-dark: #333333;
    --sauk-white: #ffffff;
    --sauk-bluegray: #455560;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background-color: var(--sauk-light);
    color: var(--sauk-dark);
    font-family: Arial, Helvetica, sans-serif;
}

button {
    font-family: inherit;
}

button:focus-visible {
    outline: 4px solid #ffffff;
    outline-offset: 3px;
}

.game-container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 28px;
}

/* =========================
   HEADER
========================= */

.game-header {
    margin-bottom: 25px;
    text-align: center;
}

.game-header h1 {
    margin: 0 0 8px;
    color: var(--sauk-red);
    font-size: clamp(2rem, 5vw, 3.2rem);
}

.game-header p {
    margin: 0;
    color: var(--sauk-bluegray);
    font-size: 1.05rem;
}

.header-line {
    width: 90px;
    height: 5px;
    margin: 15px auto 0;
    border-radius: 10px;
    background-color: var(--sauk-red);
}

/* =========================
   BOARD
========================= */

.board-wrapper {
    overflow-x: auto;
}

.jeopardy-board {
    display: grid;
    grid-template-columns: repeat(6, minmax(170px, 1fr));
    gap: 8px;
    min-width: 1080px;
    padding: 8px;
    border-radius: 10px;
    background-color: var(--sauk-dark);
}

.category {
    display: flex;
    min-height: 125px;
    padding: 14px;
    align-items: center;
    justify-content: center;
    background-color: var(--sauk-bluegray);
    color: var(--sauk-white);
    text-align: center;
    font-size: 1.05rem;
    font-weight: bold;
    line-height: 1.3;
}

.point-button {
    min-height: 115px;
    border: 0;
    background-color: var(--sauk-white);
    color: var(--sauk-red);
    cursor: pointer;
    font-size: 2rem;
    font-weight: bold;
    transition:
        transform .15s ease,
        background-color .15s ease;
}

.point-button:hover:not(:disabled) {
    background-color: var(--sauk-light);
    transform: scale(1.025);
}

.point-button:focus-visible {
    outline-color: var(--sauk-red);
}

.point-button.used {
    background-color: #e1e1e1;
    color: #777777;
    text-decoration: line-through;
    cursor: not-allowed;
}

.board-controls {
    display: flex;
    justify-content: center;
    margin-top: 24px;
}

.restart-button {
    min-height: 48px;
    padding: 12px 25px;
    border: 0;
    border-radius: 6px;
    background-color: var(--sauk-red);
    color: var(--sauk-white);
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
}

.restart-button:hover {
    opacity: .9;
}

/* =========================
   QUESTION SCREEN
========================= */

.question-screen {
    display: none;
    min-height: 620px;
    padding: 40px 25px;
    align-items: center;
    justify-content: center;
}

.question-card {
    width: 100%;
    max-width: 950px;
    overflow: hidden;
    border: 3px solid var(--sauk-bluegray);
    border-radius: 12px;
    background-color: var(--sauk-white);
    box-shadow: 0 7px 20px rgba(0,0,0,.12);
}

.question-top {
    display: flex;
    gap: 15px;
    padding: 16px 22px;
    align-items: center;
    justify-content: space-between;
    background-color: var(--sauk-bluegray);
    color: var(--sauk-white);
}

.question-category {
    font-size: 1rem;
    font-weight: bold;
}

.question-value {
    color: var(--sauk-white);
    font-size: 1.25rem;
    font-weight: bold;
}

.question-body {
    padding: 45px 40px;
    text-align: center;
}

.question-text {
    margin: 0;
    color: var(--sauk-dark);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: bold;
    line-height: 1.4;
}

.answer-box {
    display: none;
    margin-top: 35px;
    padding: 25px;
    border-left: 7px solid var(--sauk-red);
    background-color: var(--sauk-light);
    text-align: left;
}

.answer-label {
    display: block;
    margin-bottom: 8px;
    color: var(--sauk-red);
    font-weight: bold;
    text-transform: uppercase;
}

.answer-text {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.6;
}

.question-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
    justify-content: center;
}

.action-button {
    min-height: 48px;
    padding: 12px 24px;
    border: 0;
    border-radius: 6px;
    color: var(--sauk-white);
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
}

.reveal-button {
    background-color: var(--sauk-red);
}

.back-button {
    display: none;
    background-color: var(--sauk-bluegray);
}

.action-button:hover {
    opacity: .9;
}

/* =========================
   SCREEN READER
========================= */

.sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0,0,0,0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

    .game-container {
        padding: 16px;
    }

    .question-body {
        padding: 30px 20px;
    }

    .question-top {
        align-items: flex-start;
        flex-direction: column;
    }

    .question-screen {
        padding: 20px 5px;
    }
}
</style>
</head>

<body>

