<script>

/* ==========================================
   QUESTIONS AND ANSWERS
========================================== */

const gameData = {

    "Business Basics": {

        100: {
            question:
                "What does outsourcing mean?",
            answer:
                "Outsourcing means hiring an outside person or company to perform work that could otherwise be done internally. It may involve another country, but outsourcing does not always mean sending work overseas."
        },

        200: {
            question:
                "If a business had revenue of $100,000 and expenses of $80,000, what is the profit?",
            answer:
                "$20,000. Profit = Revenue − Expenses, so $100,000 − $80,000 = $20,000."
        },

        300: {
            question:
                "What is the word for all the people impacted by or involved with business operations?",
            answer:
                "Stakeholders."
        },

        400: {
            question:
                "What is the difference between standard of living and quality of life?",
            answer:
                "Standard of living generally refers to how much people can afford and the material goods and services available to them. Quality of life refers more broadly to overall well-being, including factors such as health, safety, political freedom, relationships, leisure, and personal satisfaction. A person can have a high standard of living but still experience a relatively low quality of life."
        }

    },


    "Factors of Production": {

        100: {
            question:
                "Give two examples of capital.",
            answer:
                "Examples include money, machinery, equipment, tools, buildings, computers, factories, or other resources used to produce goods and services."
        },

        200: {
            question:
                "What is causing a job shortage or a restructuring of the work that needs to be done?",
            answer:
                "Knowledge, particularly in the form of technological advances."
        },

        300: {
            question:
                "Land as a factor of production includes more than just physical land. What else does it include?",
            answer:
                "Natural resources, such as water, minerals, oil, forests, and other resources that come from nature."
        },

        400: {
            question:
                "Which two factors of production are most likely to create the most wealth when combined?",
            answer:
                "Entrepreneurship and knowledge."
        }

    },


    "The Business Environment": {

        100: {
            question:
                "Name two ways a business can be more competitive.",
            answer:
                "Possible answers include product differentiation, higher quality, better customer service, lower prices, greater convenience, innovation, stronger branding, or faster delivery."
        },

        200: {
            question:
                "What's the difference between effective and efficient?",
            answer:
                "Effective means accomplishing the intended goal or doing what was supposed to be done. Efficient means accomplishing the task while using as few resources—such as time, money, or labor—as reasonably possible."
        },

        300: {
            question:
                "What is demography?",
            answer:
                "Demography is the study of the characteristics of a population, such as age, income, education, race, gender, geographic location, and other population traits."
        },

        400: {
            question:
                "How can the government help the business environment?",
            answer:
                "Examples include maintaining reasonable tax policies, enforcing contracts and property rights, supporting infrastructure, maintaining economic stability, reducing unnecessary barriers to starting businesses, and establishing laws that create a predictable environment for commerce."
        }

    },


    "The Major Economic Systems": {

        100: {
            question:
                "China, North Korea, Laos, and Cuba all operate under which economic system?",
            answer:
                "Communism."
        },

        200: {
            question:
                "What is brain drain?",
            answer:
                "Brain drain occurs when highly educated, talented, or skilled people leave a country or region, taking their knowledge and expertise with them."
        },

        300: {
            question:
                "What is the central idea of socialism?",
            answer:
                "Socialism emphasizes greater government involvement in the economy and a more even distribution of income and resources, often using tax revenue to provide social programs and public services."
        },

        400: {
            question:
                "What's one of the biggest criticisms of capitalism?",
            answer:
                "Income inequality—the benefits and wealth created within a capitalist economy may be distributed very unevenly."
        }

    },


    "Economic Indicators": {

        100: {
            question:
                "What's the difference between disinflation and deflation?",
            answer:
                "With disinflation, prices are still increasing, but they are increasing more slowly than before. With deflation, the overall price level is actually decreasing."
        },

        200: {
            question:
                "What measures the total value of final goods and services produced in a country during a specific period of time?",
            answer:
                "Gross Domestic Product, or GDP."
        },

        300: {
            question:
                "What type of unemployment includes people who are temporarily between jobs or just entering the workforce?",
            answer:
                "Frictional unemployment."
        },

        400: {
            question:
                "How does the Federal Reserve use monetary policy to influence the economy?",
            answer:
                "The Federal Reserve influences the economy primarily by affecting interest rates and the money supply. Lower rates generally encourage borrowing and spending, while higher rates generally slow borrowing and spending. Raising or lowering taxes is fiscal policy and is controlled by the government, not the Federal Reserve."
        }

    },


    "Free Market Concepts": {

        100: {
            question:
                "In which direction does a supply curve slope?",
            answer:
                "Upward."
        },

        200: {
            question:
                "What is the spot called where the supply curve and demand curve meet?",
            answer:
                "The equilibrium point."
        },

        300: {
            question:
                "What's an example of a seller in a monopoly?",
            answer:
                "A common example is a local utility provider, such as an electric, natural gas, or water company when it is the only provider in a particular geographic area."
        },

        400: {
            question:
                "When products are nearly identical and all sell for a very similar price, what type of competition are the sellers in?",
            answer:
                "Perfect competition."
        }

    }

};


/* ==========================================
   PAGE ELEMENTS
========================================== */

const boardScreen =
    document.getElementById("board-screen");

const questionScreen =
    document.getElementById("question-screen");

const questionCategory =
    document.getElementById("question-category");

const questionValue =
    document.getElementById("question-value");

const questionText =
    document.getElementById("question-text");

const answerBox =
    document.getElementById("answer-box");

const answerText =
    document.getElementById("answer-text");

const revealButton =
    document.getElementById("reveal-button");

const backButton =
    document.getElementById("back-button");

const restartButton =
    document.getElementById("restart-button");

let currentButton = null;


/* ==========================================
   OPEN QUESTION
========================================== */

document
.querySelectorAll(".point-button")
.forEach(function(button) {

    button.addEventListener(
        "click",
        function() {

            if (button.disabled) {
                return;
            }

            currentButton = button;

            const category =
                button.dataset.category;

            const value =
                button.dataset.value;

            const data =
                gameData[category][value];

            questionCategory.textContent =
                category;

            questionValue.textContent =
                value + " Points";

            questionText.textContent =
                data.question;

            answerText.textContent =
                data.answer;

            answerBox.style.display =
                "none";

            revealButton.style.display =
                "inline-block";

            backButton.style.display =
                "none";

            boardScreen.style.display =
                "none";

            questionScreen.style.display =
                "flex";

            questionText.focus();

        }
    );

});


/* ==========================================
   REVEAL ANSWER
========================================== */

revealButton.addEventListener(
    "click",
    function() {

        answerBox.style.display =
            "block";

        revealButton.style.display =
            "none";

        backButton.style.display =
            "inline-block";

        answerBox.setAttribute(
            "tabindex",
            "-1"
        );

        answerBox.focus();

    }
);


/* ==========================================
   BACK TO BOARD
========================================== */

backButton.addEventListener(
    "click",
    function() {

        if (currentButton) {

            currentButton.classList.add(
                "used"
            );

            currentButton.disabled = true;

            currentButton.setAttribute(
                "aria-label",
                currentButton.dataset.category +
                " for " +
                currentButton.dataset.value +
                " points, already used"
            );

        }

        questionScreen.style.display =
            "none";

        boardScreen.style.display =
            "block";

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

        const nextUnused =
            document.querySelector(
                ".point-button:not(:disabled)"
            );

        if (nextUnused) {
            nextUnused.focus();
        } else {
            restartButton.focus();
        }

    }
);


/* ==========================================
   RESTART GAME
========================================== */

restartButton.addEventListener(
    "click",
    function() {

        const confirmRestart =
            window.confirm(
                "Restart the game and make all questions available again?"
            );

        if (!confirmRestart) {
            return;
        }

        document
        .querySelectorAll(".point-button")
        .forEach(function(button) {

            button.disabled = false;

            button.classList.remove(
                "used"
            );

            button.setAttribute(
                "aria-label",
                button.dataset.category +
                " for " +
                button.dataset.value +
                " points"
            );

        });

        document
        .querySelector(".point-button")
        .focus();

    }
);

</script>

